# Create an Anthropic Console API key; do not put a real key in this committed example.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LOCAL_DATA_DIR=./data
# Safe offline development/testing default; switch to false for actual Claude calls.
AI_MOCK_MODE=true
# Optional: explicitly enable one real low-cost connectivity smoke test.
RUN_LIVE_AI_SMOKE=0
